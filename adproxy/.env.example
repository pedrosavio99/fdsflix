# ==============================================================================
# AdShield Proxy — configuração mínima
# Copie para .env e ajuste. No Render, use o dashboard (Environment).
# ==============================================================================

# Porta (Render injeta a dele; localmente o padrão é 3000)
PORT=3000
HOST=0.0.0.0

# Já vem embutido em lib/config.js (https://vidlink.pro); defina só para trocar.
# Origem do site que será proxiado (sem caminho, sem barra no fim).
# Use a origem canônica final (ex.: https://www.site.com, e não https://site.com
# se o site redireciona para www).
# TARGET_ORIGIN=https://site-alvo.com

# Já vem embutida em lib/config.js (valor público); defina só para trocar.
# Chave aleatória usada para assinar URLs de recursos.
# Gere com: openssl rand -hex 32
# No Render, o Blueprint usa generateValue: true.
# PROXY_SECRET=
# Gere com: openssl rand -hex 32

# ==============================================================================
# Comportamento
# ==============================================================================

# Proxiar também iframes de player de terceiros (0 = mantém direto).
# 1 permite sanitizar o conteúdo do player, mas pode quebrar players que
# validam domínio/origem, Cloudflare ou sessões assinadas. Teste por site.
PROXY_PLAYER_IFRAMES=0

# Adiciona sandbox restritivo em iframes de player (remove allow-popups e
# allow-top-navigation). Pode quebrar login/compartilhamento dentro do player.
HARDEN_PLAYER_IFRAMES=0

# Reescrever links externos para passarem pelo proxy (0 = links externos vão
# direto para o destino). Ative só se quiser proxiar o site inteiro.
REWRITE_EXTERNAL_LINKS=0

# Bloquear window.open para domínios externos (popunders). Links same-origin
# continuam funcionando. Domínios permitidos vão em POPUP_ALLOW_HOSTS.
BLOCK_POPUPS=1

# Injetar stubs de adsbygoogle/googletag e de detectores de adblock.
INJECT_ADBLOCK_STUBS=1
INJECT_HIDING_CSS=1

# Encaminhar cookies do navegador para o site alvo (não encaminha para CDNs
# cross-origin, para não vazar sessão).
FORWARD_COOKIES=1

# Permitir que o proxy busque hosts privados/IPs internos. Deixe 0 em produção:
# isso evita SSRF. O TARGET_ORIGIN configurado é sempre permitido.
ALLOW_PRIVATE_UPSTREAMS=0

# Buscar recursos de outros domínios (CDNs, players). Se 0, o navegador vai
# direto neles; o HTML continua sendo sanitizado.
ALLOW_CROSS_ORIGIN=1

# ==============================================================================
# Listas extras (separadas por vírgula)
# ==============================================================================
# Hosts adicionais considerados players de vídeo.
EXTRA_PLAYER_HOSTS=
# Domínios externos que ainda podem abrir popup via window.open.
# POPUP_ALLOW_HOSTS=accounts.google.com

# ==============================================================================
# Limites / diagnóstico
# ==============================================================================
UPSTREAM_TIMEOUT_MS=30000
MAX_HTML_BYTES=8388608
MAX_CSS_BYTES=4194304
MAX_REQUEST_BODY_BYTES=2097152
UPSTREAM_USER_AGENT=
DEBUG=0
