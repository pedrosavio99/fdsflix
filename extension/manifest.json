{
  "manifest_version": 3,
  "name": "fdsFlix Direct + AdShield",
  "version": "1.0.0",
  "description": "Deixa o vídeo do fdsFlix ir direto do provedor ao navegador (0 Render) e remove anúncios dos players embutidos.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fdsflix_direct",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "main.js"
      ],
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "fdsFlix Direct + AdShield"
  },
  "background": {
    "service_worker": "background.js"
  }
}
