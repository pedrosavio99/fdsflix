          "operation": "set",
          "value": "Content-Range, Content-Length, Accept-Ranges, Content-Type"
        },
        {
          "header": "access-control-allow-methods",
          "operation": "set",
          "value": "GET, HEAD, OPTIONS"
        }
      ]
    },
    "condition": {
      "initiatorDomains": [
        "fdsflix-80ya.onrender.com",
        "fdsflix.onrender.com",
        "localhost"
      ],
      "excludedRequestDomains": [
        "fdsflix-80ya.onrender.com",
        "fdsflix.onrender.com",
        "localhost"
      ],
      "resourceTypes": [
        "media",
        "xmlhttprequest",
        "other"
      ]
    }
  },
