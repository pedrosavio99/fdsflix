{
  "name": "fdsflix",
  "version": "2.0.0",
  "description": "Player de filmes e séries com busca no TMDB e stream via VidLink Pro (proxy + transcodificação HEVC->H.264)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "adproxy": "npm --prefix adproxy start",
    "test:adproxy": "npm --prefix adproxy test",
    "pool:check": "node scripts/pool-check.js",
    "test": "node --test test/*.test.js",
    "fallback:check": "node scripts/adshield-check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@definisi/vidsrc-scraper": "^2.0.2",
    "@usm0n/stream-utils": "^1.0.0",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "tweetnacl": "^1.0.3"
  }
}
