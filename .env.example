# Porta do servidor (Railway/Render injetam a deles; a Vercel não usa)
PORT=3000

# Chave de API do TMDB (The Movie Database) para busca de filmes e séries
TMDB_API_KEY=sua_chave_tmdb_aqui

# Chave secreta e endpoint do extrator VidLink Pro
VIDLINK_KEY_HEX=coloque_a_chave_hex_aqui
VIDLINK_API_URL=https://vidlink.pro/api/b

# Opcional: URL pública do backend (usada para devolver URLs absolutas na API)
# PUBLIC_BASE_URL=https://seu-backend.onrender.com

# Opcional: chave para proteger /api/search, /api/popular e /api/stream
# API_KEY=uma_chave_forte_aqui

# Opcional: teto de resolução da transcodificação (240/360/480/720/1080)
# Em hosts fracos (Render Free) use 360 ou 240.
# MAX_TRANSCODE_HEIGHT=720

# Opcional: quantas conversões simultâneas (1 no Render Free)
# MAX_SESSIONS=2

# ==============================================================================
# Fontes de Fallback (Cascata Multi-Provedor)
# O servidor tenta cada provedor na ordem até encontrar um stream válido.
# Padrão: VidLink Pro -> CinePro -> CineWinx -> Stream-Winx -> Consumet -> Vidsrc -> Embed.su -> MegaMoviesLibre
# ==============================================================================
# CINEPRO_API_BASE=http://localhost:3001
# CINEWINX_API_BASE=http://localhost:3002
# STREAM_WINX_API_BASE=http://localhost:3004
# CONSUMET_API_BASE=http://localhost:3003
# MEGAMOVIES_API_BASE=https://libreflix.org/api
# API5_API_BASE=http://localhost:3005
# KEKIKSTREAM_API_BASE=http://localhost:3006
# FALLBACK_ORDER=VidLink Pro,CinePro,CineWinx,Stream-Winx,Consumet,Vidsrc,Embed.su,MegaMoviesLibre

# ==============================================================================
# CinePro Core embutido (Docker)
# O Dockerfile baixa/compila o CinePro em /opt/cinepro e o servidor o sobe
# sozinho em 127.0.0.1:3001 (só o fdsFlix acessa). Fora do Docker não faz nada.
# ==============================================================================
# CINEPRO_EMBEDDED=0        # 0 = não sobe o CinePro (ex.: host com pouca RAM)
# CINEPRO_PORT=3001
# CINEPRO_NODE_OPTIONS=--max-old-space-size=192
# CINEPRO_API_BASE=http://host:porta   # usa um CinePro EXTERNO em vez do embutido

# ==============================================================================
# Anime (AnimeFire) — só age em animação japonesa do TMDB
# ==============================================================================
# ANIMEFIRE_ENABLED=0                          # 0 = desliga
# ANIMEFIRE_API_BASE=https://api.animefire.one # se a API mudar de endereço
# ANIMEFIRE_SITE=https://animefire.one         # Origin/Referer exigidos pela API e pelo CDN

# ==============================================================================
# Worker Repassador de Vídeos / APIs (Cloudflare Worker Streaming Relay)
# Opcional: contorna bloqueios de IP de datacenter (HTTP 403 / 429) em hosts como
# Render, Vercel ou VPS para AnimeFire e provedores de vídeo externos.
# Baseado no mesmo modelo do SM_RELAY do modulo-playlist.
# Veja instruções de deploy em deploy/cloudflare-worker/README.md
# ==============================================================================
# VIDEO_RELAY_URL=https://seu-worker.seu-usuario.workers.dev
# VIDEO_RELAY_KEY=sua_chave_secreta

# ==============================================================================
# Entrega de vídeo pela borda (Cloudflare Worker) — não gasta a banda do Render
# Com VIDEO_RELAY_URL + VIDEO_RELAY_KEY definidos, o /api/stream devolve ao player
# uma URL do Worker (<worker>/m/<token assinado>) em vez de /api/proxy. O Render só
# assina o token (~1 KB); o vídeo passa pelo Worker. Fontes locais (CinePro em
# 127.0.0.1) e vídeo convertido pelo ffmpeg continuam saindo pelo Render.
# ==============================================================================
# EDGE_MEDIA=0   # 0 = volta a entregar tudo pelo Render
#
# Alguns CDNs de vídeo recusam a rede da Cloudflare (o Worker recebe 4xx). O servidor testa
# isso com 1 byte antes de usar a borda e, se falhar, entrega pelo Render. Para tirar a banda
# do Render mesmo assim, hospede o relay Node (deploy/media-relay) numa VM com muita banda
# (ex.: Oracle Always Free, ~10 TB/mês) e aponte só o VÍDEO para ela — o Worker continua
# nas consultas aos provedores:
# MEDIA_RELAY_URL=https://relay.seu-dominio.duckdns.org
# MEDIA_RELAY_KEY=mesma_chave_do_RELAY_KEY_da_VM
